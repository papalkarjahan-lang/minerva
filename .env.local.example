# Copy this file to .env.local and fill in your real values
# NEVER commit .env.local to GitHub

# Supabase - from your project dashboard > Settings > API
VITE_SUPABASE_URL=https://yourproject.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Mapbox - from mapbox.com > Tokens
VITE_MAPBOX_TOKEN=pk.eyJ1IjoieW91cnVzZXJuYW1lIiwi...

# Stripe - from stripe.com/au > Developers > API keys
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...

# Your app URL (used for tracking links in SMS)
VITE_APP_URL=https://minervaops.com.au

# Internal admin console (2026-09-05) - comma-separated list of Minerva
# staff emails allowed to open /admin. Leave unset and /admin shows
# "Not authorized" to everyone.
VITE_ADMIN_EMAILS=you@yourcompany.com

# Optional error monitoring (2026-09-05) - leave unset and this is a no-op.
# Get a free DSN at sentry.io.
VITE_SENTRY_DSN=
